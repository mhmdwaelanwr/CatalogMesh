# انسخ هذا الملف إلى .env ثم أضف بياناتك.
GEMINI_API_KEY_1='YOUR_FIRST_KEY'
GEMINI_API_KEY_2='YOUR_SECOND_KEY'
GEMINI_API_KEY_3='YOUR_THIRD_KEY'
GEMINI_API_KEY_4='YOUR_FOURTH_KEY'

APP_LANGUAGE=''
APP_THEME='dark'
# Local-first example: ollama,gemini,openai,anthropic
# Fully offline/local example: ollama
AI_PROVIDERS='gemini,openai,anthropic'

# Ollama local vision. No API key is required.
OLLAMA_BASE_URL='http://127.0.0.1:11434'
OLLAMA_MODEL='gemma4'
OLLAMA_KEEP_ALIVE='10m'
OLLAMA_TIMEOUT='300'
# Cache already-encoded overlap images in memory. 0 disables the cache.
PRODUCT_SORTER_IMAGE_CACHE_ENTRIES='24'

GEMINI_MODEL='gemini-3.6-flash'
OPENAI_API_KEY_1='YOUR_FIRST_OPENAI_KEY'
OPENAI_API_KEY_2=''
OPENAI_API_KEY_3=''
OPENAI_API_KEY_4=''
OPENAI_MODEL='gpt-4.1-mini'
OPENAI_BASE_URL=''
ANTHROPIC_API_KEY_1='YOUR_FIRST_ANTHROPIC_KEY'
ANTHROPIC_API_KEY_2=''
ANTHROPIC_API_KEY_3=''
ANTHROPIC_API_KEY_4=''
ANTHROPIC_MODEL='claude-sonnet-4-5'
COST_PER_REQUEST='0'
VALIDATE_KEYS='true'
USE_KEYRING='false'
GEMINI_INPUT_COST_PER_MILLION='0'
GEMINI_OUTPUT_COST_PER_MILLION='0'
OPENAI_INPUT_COST_PER_MILLION='0'
OPENAI_OUTPUT_COST_PER_MILLION='0'
ANTHROPIC_INPUT_COST_PER_MILLION='0'
ANTHROPIC_OUTPUT_COST_PER_MILLION='0'
PRODUCT_SOURCE='/path/to/Products'
PRODUCT_OUTPUT='/path/to/Sorted_Products'
PRICES_FILE='/path/to/prices.xlsx'

# Optional: one operation-wide SMART_REPORT.md containing deterministic catalog
# facts plus one final text-only AI analysis/recommendation call.
PRODUCT_SORTER_MD_REPORT='false'

# copy = independent output files (safest; needs roughly source-size free space)
# auto = hardlink -> symlink -> copy fallback (saves space, but linked images
#        must not be edited if source originals need to remain byte-identical)
# hardlink / symlink = explicit reference mode; fails if unsupported.
PRODUCT_SORTER_OUTPUT_MODE='copy'

BATCH_SIZE='6'
CONFIDENCE='0.75'
MAX_RETRIES='5'
PHOTO_LIMIT=''
